<?xml version="1.0" encoding="utf-8"?>
<!-- Bundle do AutoCAD: carregado sozinho a partir de %APPDATA%\Autodesk\ApplicationPlugins (pasta confiável). -->
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    ProductType="Application"
    Name="AlvMod"
    Description="Modulação de alvenaria autoportante (1ª e 2ª fiada)"
    AppVersion="__VERSAO__"
    ProductCode="{08FA3772-8476-41AB-957F-783FA2A3F315}"
    UpgradeCode="{8C1820C2-9124-46A4-A003-2C12B7607CF2}"
    Author="AlvMod">
  <CompanyDetails Name="AlvMod" />

  <!-- AutoCAD 2018 a 2024: .NET Framework 4.8 -->
  <Components Description="AutoCAD 2018 a 2024">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R22.0" SeriesMax="R24.3" />
    <ComponentEntry
        AppName="AlvMod"
        ModuleName="./Contents/net48/AlvMod.Plugin.dll"
        AppDescription="Modulação de alvenaria autoportante"
        LoadOnAutoCADStartup="True" />
  </Components>

  <!-- AutoCAD 2025 em diante: .NET 8 -->
  <Components Description="AutoCAD 2025 em diante">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" />
    <ComponentEntry
        AppName="AlvMod"
        ModuleName="./Contents/net8/AlvMod.Plugin.dll"
        AppDescription="Modulação de alvenaria autoportante"
        LoadOnAutoCADStartup="True" />
  </Components>
</ApplicationPackage>
